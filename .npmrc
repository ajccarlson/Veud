# legacy-peer-deps is on because @nasa-gcn/remix-seo declares a peer on
# @remix-run/react ^1 || ^2, and this project moved to React Router v7, which
# no longer publishes that package. The peer is unsatisfiable rather than
# merely stale, so npm cannot resolve the tree without it.
#
# The cost is real and worth knowing: peer checking is disabled for *every*
# package, so an incompatible install succeeds silently. That is how an ESLint
# 10 upgrade installed cleanly and then failed at run time. `npm run
# deps:peer-report` lists mismatches that this setting hides.
legacy-peer-deps=true
registry=https://registry.npmjs.org/
