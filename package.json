{
  "name": "veud",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "homepage": "https://www.veud.net/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajccarlson/Veud.git"
  },
  "bugs": {
    "url": "https://github.com/ajccarlson/Veud/issues"
  },
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "build": "run-s build:*",
    "bundle:check": "node scripts/check-client-bundle-budgets.mjs",
    "build:icons": "tsx ./other/build-icons.ts",
    "build:react-router": "react-router build",
    "build:server": "tsx ./other/build-server.ts",
    "catalog:mangaupdates-releases": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/import-mangaupdates-releases.ts",
    "catalog:mal-hydrate": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/hydrate-mal-catalog.ts",
    "catalog:mal-inventory": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/import-mal-inventory.ts",
    "catalog:mal-trending": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/refresh-mal-trending.ts",
    "catalog:repair-provenance": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/quarantine-media-catalog-provenance.ts",
    "catalog:sync-watchlist-metadata": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/sync-watchlist-metadata.ts",
    "catalog:status": "tsx scripts/catalog-status.ts",
    "catalog:quality-scan": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/scan-catalog-quality.ts",
    "catalog:anime-tmdb-ids": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/resolve-anime-tmdb-ids.ts",
    "catalog:tmdb-watch-providers": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/import-tmdb-watch-providers.ts",
    "catalog:tmdb-hydrate": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/hydrate-tmdb-catalog.ts",
    "catalog:tmdb-inventory": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/import-tmdb-inventory.ts",
    "db:backup": "node scripts/assert-catalog-writer-runtime.mjs && node scripts/backup-database.mjs",
    "db:backup:postgres": "node scripts/assert-catalog-writer-runtime.mjs && node scripts/backup-postgres.mjs",
    "db:backup:sqlite": "node scripts/backup-db.mjs",
    "db:canary:postgres": "node scripts/canary-postgres.mjs",
    "db:canary:catalog-merge:postgres": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/canary-catalog-media-merge.ts --run",
    "db:cutover:postgres": "node scripts/check-postgres-cutover.mjs",
    "db:loadtest:postgres": "node scripts/assert-catalog-writer-runtime.mjs && node scripts/load-test-postgres-catalog.mjs",
    "db:migrate:postgres": "node scripts/assert-catalog-writer-runtime.mjs && npm run prisma:postgres:check && prisma migrate deploy --schema=prisma/postgresql/schema.prisma",
    "db:smoke:public-surfaces:postgres": "tsx scripts/smoke-public-surfaces-postgres.ts",
    "db:smoke:postgres": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/smoke-postgres.ts",
    "db:transfer:postgres": "node scripts/assert-catalog-writer-runtime.mjs && node scripts/transfer-sqlite-to-postgres.mjs",
    "db:verify:postgres": "npm run prisma:postgres:check && prisma migrate status --schema=prisma/postgresql/schema.prisma && prisma migrate diff --exit-code --from-schema-datasource=prisma/postgresql/schema.prisma --to-schema-datamodel=prisma/postgresql/schema.prisma",
    "db:verify-backup": "node scripts/verify-database-backup.mjs",
    "db:verify-backup:postgres": "node scripts/verify-postgres-backup.mjs",
    "db:verify-backup:sqlite": "node scripts/verify-backup.mjs",
    "data:backfill-next-release-at": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/backfill-next-release-at.ts",
    "data:release-audit": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/audit-release-data.ts",
    "data:loader-decimal-audit": "node scripts/audit-loader-decimals.mjs",
    "data:integrity-audit": "npm run data:loader-decimal-audit && node --import tsx scripts/audit-data-integrity.ts",
    "data:retention:cleanup": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/cleanup-expired-data.ts",
    "media:backfill": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/backfill-media-identities.ts",
    "moderation:bootstrap-owner": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/bootstrap-community-owner.ts",
    "notifications:digests": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/send-notification-digests.ts",
    "postinstall": "node scripts/patch-brace-expansion-compat.mjs",
    "deps:peer-report": "node scripts/report-peer-mismatches.mjs",
    "prisma:generate:postgres": "npm run prisma:postgres:check && cross-env DATABASE_URL=postgresql://schema-generation:unused@localhost:5432/veud prisma generate --schema=prisma/postgresql/schema.prisma",
    "prisma:generate:sqlite": "prisma generate --schema=prisma/schema.prisma",
    "prisma:postgres:check": "node scripts/sync-postgres-prisma-schema.mjs --check && cross-env DATABASE_URL=postgresql://schema-validation:unused@localhost:5432/veud prisma validate --schema=prisma/postgresql/schema.prisma",
    "prisma:postgres:sync-schema": "node scripts/sync-postgres-prisma-schema.mjs",
    "production:catalog:deploy": "bash ops/local-production/deploy-catalog-release.sh",
    "production:postgres:prepare": "bash ops/local-production/prepare-target.sh",
    "production:postgres:provision": "bash ops/local-production/provision.sh",
    "production:postgres:status": "bash ops/local-production/status.sh",
    "production:postgres:switch-environment": "node ops/local-production/switch-environment.mjs",
    "tracking:backfill": "node scripts/assert-catalog-writer-runtime.mjs && node --import tsx scripts/backfill-tracking-states.ts",
    "predev": "npm run prisma:generate:sqlite && npm run build:icons --silent",
    "dev": "cross-env NODE_ENV=development node ./server/dev-server.js",
    "prisma:studio": "node scripts/assert-catalog-writer-runtime.mjs && prisma studio",
    "format": "prettier --write .",
    "lint": "eslint .",
    "setup": "node scripts/assert-catalog-writer-runtime.mjs && npm run build && prisma generate && prisma migrate deploy && prisma db seed && playwright install",
    "prestart": "npm run prisma:generate:postgres",
    "start": "node scripts/assert-not-production-start.mjs && cross-env NODE_ENV=production node .",
    "prestart:mocks": "npm run prisma:generate:sqlite",
    "start:mocks": "cross-env NODE_ENV=production MOCKS=true tsx .",
    "start:dev": "npm run prisma:generate:sqlite && cross-env NODE_ENV=development pm2 start ecosystem.config.cjs --env development",
    "start:prod": "npm run prisma:generate:postgres && npm run production:preflight && cross-env NODE_ENV=production pm2 start ecosystem.config.cjs --env production",
    "production:preflight": "node scripts/preflight-production.mjs",
    "staging:check": "node scripts/check-staging-acceptance.mjs",
    "staging:local:deploy": "bash ops/local-staging/deploy.sh",
    "staging:local:provision": "bash ops/local-staging/provision.sh",
    "staging:local:status": "bash ops/local-staging/status.sh",
    "stop:dev": "cross-env NODE_ENV=development pm2 stop ecosystem.config.cjs --env development",
    "stop:prod": "cross-env NODE_ENV=production pm2 stop ecosystem.config.cjs --env production",
    "pretest": "npm run prisma:generate:sqlite",
    "test": "vitest",
    "precoverage": "npm run prisma:generate:sqlite",
    "coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:dev --silent",
    "test:e2e:dev": "playwright test --ui",
    "test:e2e:server": "tsx ./tests/setup/playwright-server.ts",
    "pretest:e2e:run": "npm run build",
    "test:e2e:run": "cross-env CI=true playwright test",
    "test:e2e:gates": "cross-env CI=true playwright test tests/e2e/accessibility.test.ts tests/e2e/visual-regression.test.ts --project=chromium",
    "test:e2e:install": "npx playwright install --with-deps chromium",
    "typecheck": "react-router typegen && tsc",
    "validate": "run-p \"test -- --run\" lint typecheck test:e2e:run",
    "validate:release": "run-s validate:release:static validate:release:unit validate:release:build validate:release:browser",
    "validate:release:hosted": "run-s validate:release:static validate:release:unit validate:release:build validate:release:browser:portable",
    "validate:release:static": "npm run build:icons && npm run lint && npm run typecheck",
    "validate:release:unit": "npm run test -- --run --coverage",
    "validate:release:build": "npm run build && npm run bundle:check",
    "validate:release:browser": "cross-env CI=true PORT=4122 playwright test --project=chromium",
    "validate:release:browser:portable": "cross-env CI=true PORT=4122 playwright test --project=chromium --ignore-snapshots",
    "validate:release:postgres": "npm run prisma:generate:postgres && npm run db:migrate:postgres && npm run db:verify:postgres && npm run db:smoke:postgres && npm run db:loadtest:postgres -- --commit --count 2000 --member-count 20 --tracking-per-member 100 --activity-per-member 20 --cleanup-after && npm run db:canary:catalog-merge:postgres",
    "validate:scale:postgres": "npm run prisma:generate:postgres && npm run db:migrate:postgres && npm run db:verify:postgres && npm run db:smoke:postgres && npm run db:loadtest:postgres -- --commit --count 100000 --member-count 1000 --tracking-per-member 100 --activity-per-member 20 --require-trigram-indexes --require-calendar-indexes --require-community-indexes --require-profile-indexes --cleanup-after"
  },
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/coverage",
    "/public/build",
    "/playwright-report",
    "/server-build"
  ],
  "dependencies": {
    "@conform-to/react": "^1.20.2",
    "@conform-to/zod": "^1.20.2",
    "@epic-web/cachified": "^5.1.2",
    "@epic-web/client-hints": "^1.3.0",
    "@epic-web/invariant": "^1.0.0",
    "@epic-web/remember": "^1.0.2",
    "@epic-web/totp": "^4.0.1",
    "@nasa-gcn/remix-seo": "^2.0.0",
    "@nivo/bar": "^0.99.0",
