    "@nivo/calendar": "^0.99.0",
    "@nivo/chord": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@nivo/radial-bar": "^0.99.0",
    "@nivo/waffle": "^0.99.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-router/express": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@remix-run/form-data-parser": "^0.17.4",
    "@sentry/profiling-node": "^10.68.0",
    "@sentry/react-router": "^10.68.0",
    "address": "^2.0.2",
    "ag-grid-community": "^36.0.2",
    "ag-grid-react": "^36.0.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "chalk": "^5.3.0",
    "class-variance-authority": "^0.7.0",
    "close-with-grace": "^2.5.0",
    "clsx": "^2.1.0",
    "compression": "^1.7.4",
    "cookie": "^2.0.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "execa": "^10.0.0",
    "express": "^4.18.3",
    "express-rate-limit": "^8.6.2",
    "get-port": "^7.0.0",
    "glob": "^13.0.6",
    "helmet": "^8.3.0",
    "isbot": "^5.2.1",
    "lru-cache": "^11.5.2",
    "morgan": "^1.10.0",
    "pm2": "^7.0.3",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remix-auth": "^4.2.0",
    "remix-auth-oauth2": "^3.4.1",
    "remix-utils": "^10.0.0",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "sonner": "^1.4.3",
    "source-map-support": "^0.5.21",
    "spin-delay": "^2.0.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-radix": "^2.8.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.62.0",
    "@react-router/dev": "^8.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/better-sqlite3": "^7.6.9",
    "@types/compression": "^1.7.5",
    "@types/cookie": "^1.0.0",
    "@types/eslint": "^9.6.1",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/set-cookie-parser": "^2.4.7",
    "@types/source-map-support": "^0.5.10",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "enforce-unique": "^1.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "fs-extra": "^11.4.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "node-html-parser": "^6.1.12",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "set-cookie-parser": "^3.1.2",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "22",
    "npm": ">=10"
  },
  "overrides": {
    "@react-spring/web": "9.4.5",
    "brace-expansion": "5.0.8"
  },
  "epic-stack": true
}
