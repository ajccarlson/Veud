[Unit]
Description=Veud staging Jikan anime cast hydration
Wants=network-online.target
After=network-online.target veud-staging-postgres.service
Requires=veud-staging-postgres.service

[Service]
Type=simple
ExecStart=%h/Programs/Veud/ops/local-staging/run-jikan-anime-cast.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=90
